# ============================================================
#  Restaurant Review & Reservation Management System
#  .gitignore  –  root level (covers Backend + Restaurant)
# ============================================================

# -------------------------------------------------------
# Python / Django (Backend)
# -------------------------------------------------------

# Virtual environments
.venv/
venv/
env/
ENV/
.env/

# Compiled Python files
__pycache__/
*.py[cod]
*$py.class
*.pyo

# Django migrations bytecode (keep migration FILES, ignore cache)
# If you want to track migrations, leave the next line commented out
*/migrations/*.py
!*/migrations/__init__.py

# Django static & media collected files
staticfiles/
mediafiles/
media/

# DB files (SQLite default dev database)
*.sqlite3
db.sqlite3

# Environment / secrets
.env
.env.*
!.env.example

# Log files
*.log
logfiles/
logs/

# Coverage reports
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover

# pytest
.pytest_cache/
.tox/

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Celery
celerybeat-schedule
celerybeat.pid

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg
MANIFEST

# -------------------------------------------------------
# Node / React / Vite (Restaurant frontend)
# -------------------------------------------------------

node_modules/

# Vite build output
dist/
dist-ssr/
*.local

# Parcel cache
.cache/
.parcel-cache/

# Storybook build output
storybook-static/

# -------------------------------------------------------
# Editors & IDEs
# -------------------------------------------------------

# VS Code (keep extensions.json if desired)
.vscode/*
!.vscode/extensions.json

# JetBrains (PyCharm, WebStorm, etc.)
.idea/
*.iml

# Vim / Emacs swap files
*.swp
*.swo
*~
\#*\#

# -------------------------------------------------------
# OS generated files
# -------------------------------------------------------

.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# -------------------------------------------------------
# Misc
# -------------------------------------------------------

# Temporary files
*.tmp
*.bak
*.orig

# Jupyter
.ipynb_checkpoints/

# npm / yarn debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
